# Copy to .env and fill in real values. Never commit the real .env — see
# .gitignore. Names only here, per infra spec §7.

# --- Local dev (apps/api reads DATABASE_URL directly) ---
DATABASE_URL=
SESSION_SECRET=
APP_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3001

# --- Web Push VAPID (reminders spec §3.6) — required, the API refuses to
# start without all three. Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT is a contact URL — "mailto:you@example.com" is fine.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Tests only (apps/api/test/setup.ts) ---
# Points at the postgres-test container from docker-compose.test.yml — see
# that file for how to start and migrate it. Falls back to this same value
# if unset, so only needed here if your test DB isn't on the default port.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/better_test

# --- docker-compose only (production deploy) ---
# Postgres container's own credentials; DATABASE_URL above is built from
# this one automatically inside docker-compose.yml, so only set this half
# when running via `docker compose up`, not for local `npm run dev`.
POSTGRES_PASSWORD=
# Domain production untuk nginx/Certbot. Tidak dipakai di production saat ini
# (nginx dikonfigurasi langsung via /etc/nginx/conf.d/bty.xvntr.my.id.conf).
SITE_ADDRESS=

# --- S3-compatible storage (storage spec §5) — optional, issue #14 ---
# Storage endpoints return 503 until these are set; everything else (todo,
# outline, agent) works fully without them. docker-compose.yml passes these
# through to the api container only when present here.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
