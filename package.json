{
  "name": "better",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"PORT=3001 npm run dev -w @better/api\" \"npm run dev -w @better/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "npm run db:generate -w @better/api",
    "db:migrate": "npm run db:migrate -w @better/api",
    "db:studio": "npm run db:studio -w @better/api",
    "user": "tsx scripts/user.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^9.1.2",
    "oxlint": "^1.77.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
